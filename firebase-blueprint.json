{
  "entities": {
    "PublishedApp": {
      "title": "PublishedApp",
      "description": "An interactive application or game published to the App and Game Playground catalog, including pricing and publisher questionnaire metadata.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Display title of the app or game.",
          "minLength": 2,
          "maxLength": 80
        },
        "tagline": {
          "type": "string",
          "description": "Short single-line summary shown in catalog cards.",
          "minLength": 4,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "description": "Detailed overview, instructions, and release notes.",
          "minLength": 10,
          "maxLength": 1500
        },
        "category": {
          "type": "string",
          "description": "Primary catalog category.",
          "enum": ["Game", "Creative App", "Developer Tool", "Utility", "Simulation"],
          "maxLength": 32
        },
        "playType": {
          "type": "string",
          "description": "Interactive runtime engine or template used to launch the experience.",
          "enum": ["starlight-tactics", "pulsepad-synth", "botanica-word", "patchforge-vision", "custom-embed"],
          "maxLength": 32
        },
        "externalUrl": {
          "type": "string",
          "description": "Optional external web URL or sandbox source for custom embeds.",
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "description": "Semantic version string such as 1.0.0.",
          "minLength": 1,
          "maxLength": 24
        },
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the publisher.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the publisher.",
          "minLength": 1,
          "maxLength": 80
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the app is publicly listed in the storefront."
        },
        "playsCount": {
          "type": "integer",
          "description": "Total interactive launch sessions."
        },
        "likesCount": {
          "type": "integer",
          "description": "Total community upvotes."
        },
        "priceCents": {
          "type": "integer",
          "description": "Price in USD cents (0 for free apps, 100 to 99999 for paid apps)."
        },
        "monetizationModel": {
          "type": "string",
          "description": "Selected monetization model from the publisher questionnaire.",
          "enum": ["Free to Play", "One-Time Purchase", "Creator Supporter Pass"],
          "maxLength": 40
        },
        "ageRating": {
          "type": "string",
          "description": "Content maturity rating from the publisher questionnaire.",
          "enum": ["Everyone (E)", "Everyone 10+ (E10+)", "Teen (T)", "Mature 17+ (M)"],
          "maxLength": 32
        },
        "dataPrivacyPolicy": {
          "type": "string",
          "description": "Data collection disclosure from the publisher questionnaire.",
          "enum": ["Zero Data Collected", "Anonymous Gameplay Telemetry Only", "Authenticated Account Sync"],
          "maxLength": 64
        },
        "accessibilityFeatures": {
          "type": "string",
          "description": "Accessibility declaration from the publisher questionnaire.",
          "enum": ["Keyboard + Mouse + High-Contrast", "Touch + Screen Reader Friendly", "Full Controller + Audio Cues"],
          "maxLength": 64
        },
        "aiVisualSummary": {
          "type": "string",
          "description": "Gemini 4 Argon visual analysis or code diagnostic summary attached to the release.",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the app was published."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the app was last updated."
        }
      },
      "required": [
        "title",
        "tagline",
        "description",
        "category",
        "playType",
        "externalUrl",
        "version",
        "authorId",
        "authorName",
        "isPublic",
        "playsCount",
        "likesCount",
        "priceCents",
        "monetizationModel",
        "ageRating",
        "dataPrivacyPolicy",
        "accessibilityFeatures",
        "aiVisualSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppReview": {
      "title": "AppReview",
      "description": "Community feedback and rating submitted for a published app or game.",
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "description": "Parent PublishedApp document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the reviewer.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the reviewer.",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "description": "Review text.",
          "minLength": 2,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the review was created."
        }
      },
      "required": [
        "appId",
        "authorId",
        "authorName",
        "rating",
        "comment",
        "createdAt"
      ]
    },
    "PublisherQuestionnaire": {
      "title": "PublisherQuestionnaire",
      "description": "Completed publisher vetting, age rating, privacy, and payout compliance questionnaire submitted when adding an app.",
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "description": "Associated PublishedApp document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the publisher.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studioName": {
          "type": "string",
          "description": "Publisher or indie studio display name.",
          "minLength": 2,
          "maxLength": 80
        },
        "ageRating": {
          "type": "string",
          "enum": ["Everyone (E)", "Everyone 10+ (E10+)", "Teen (T)", "Mature 17+ (M)"],
          "maxLength": 32
        },
        "contentAdvisory": {
          "type": "string",
          "enum": ["None", "Mild Cartoon / Tactical", "Moderate"],
          "maxLength": 40
        },
        "dataPrivacyPolicy": {
          "type": "string",
          "enum": ["Zero Data Collected", "Anonymous Gameplay Telemetry Only", "Authenticated Account Sync"],
          "maxLength": 64
        },
        "accessibilityFeatures": {
          "type": "string",
          "enum": ["Keyboard + Mouse + High-Contrast", "Touch + Screen Reader Friendly", "Full Controller + Audio Cues"],
          "maxLength": 64
        },
        "monetizationModel": {
          "type": "string",
          "enum": ["Free to Play", "One-Time Purchase", "Creator Supporter Pass"],
          "maxLength": 40
        },
        "payoutMethod": {
          "type": "string",
          "enum": ["Stripe Connect Express (85% Creator / 15% Platform)", "Instant Card Payout", "Open-Source Community Grant"],
          "maxLength": 64
        },
        "supportContact": {
          "type": "string",
          "description": "Public support URL or handle for players.",
          "minLength": 3,
          "maxLength": 120
        },
        "testedOfflineAndSandbox": {
          "type": "boolean",
          "description": "Attestation that the app runs cleanly inside the browser sandbox."
        },
        "acceptedPublisherTerms": {
          "type": "boolean",
          "description": "Attestation that publisher terms and content guidelines are accepted."
        },
        "complianceCertificateId": {
          "type": "string",
          "description": "Backend-issued questionnaire verification ID.",
          "minLength": 4,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "appId",
        "authorId",
        "studioName",
        "ageRating",
        "contentAdvisory",
        "dataPrivacyPolicy",
        "accessibilityFeatures",
        "monetizationModel",
        "payoutMethod",
        "supportContact",
        "testedOfflineAndSandbox",
        "acceptedPublisherTerms",
        "complianceCertificateId",
        "createdAt"
      ]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Completed payment or creator support transaction processed through the backend payment gateway.",
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "buyerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buyerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "recipientAuthorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amountCents": {
          "type": "integer",
          "description": "Total amount charged in USD cents (100 to 99999)."
        },
        "creatorNetCents": {
          "type": "integer",
          "description": "85% creator payout share in USD cents."
        },
        "platformFeeCents": {
          "type": "integer",
          "description": "15% platform fee in USD cents."
        },
        "currency": {
          "type": "string",
          "enum": ["USD"],
          "maxLength": 8
        },
        "paymentType": {
          "type": "string",
          "enum": ["App License Purchase", "Creator Supporter Pass"],
          "maxLength": 32
        },
        "cardBrand": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "cardLast4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "receiptNumber": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["succeeded"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "appId",
        "appTitle",
        "buyerId",
        "buyerName",
        "recipientAuthorId",
        "amountCents",
        "creatorNetCents",
        "platformFeeCents",
        "currency",
        "paymentType",
        "cardBrand",
        "cardLast4",
        "receiptNumber",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": { "$ref": "#/entities/PublishedApp" },
      "description": "Primary collection of published applications and games."
    },
    "/apps/{appId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/AppReview" },
      "description": "Subcollection of user reviews and ratings for a specific app."
    },
    "/publisherQuestionnaires/{questionnaireId}": {
      "schema": { "$ref": "#/entities/PublisherQuestionnaire" },
      "description": "Publisher onboarding and compliance questionnaires linked to published apps."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Completed payment transactions for app purchases and creator supporter passes."
    }
  }
}
